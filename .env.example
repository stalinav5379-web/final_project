MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

APPLICATION_URL=https://www.saucedemo.com/

# Name of the page under test (used for generated file names, e.g. Login → LoginPage.ts, login.spec.ts)
PAGE_NAME=Login

# Value of the test ID attribute in the DOM (e.g. data-test, data-testid, data-cy)
TEST_ID_ATTRIBUTE=data-test

# Password used in generated tests (replaces [MASKED_PASSWORD] placeholders)
APP_PASSWORD=secret_sauce

# GitHub: owner/repo (example: myname/final_project)
GITHUB_REPO=your_github_username/your_repo_name

# GitHub Personal Access Token (needs repo + pull_requests scope)
GITHUB_TOKEN=your_github_token_here
